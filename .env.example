# SQLite (relative file paths are resolved from prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Public site origin. Production must use HTTPS.
NEXT_PUBLIC_BASE_URL="http://localhost:3004"

# Authentication secrets. Leave blank in this public example.
# Generate independent values for every key; never reuse them.
# EMAIL_ENCRYPTION_KEY must be a base64-encoded 32-byte value.
EMAIL_ENCRYPTION_KEY=""
EMAIL_HMAC_KEY=""
IP_HMAC_KEY=""
TOKEN_HMAC_KEY=""
SESSION_HMAC_KEY=""

# Only enable when the reverse proxy overwrites X-Forwarded-For/X-Real-IP.
TRUST_PROXY="0"
ADMIN_EMAIL=""

# Amazon SES. Credentials must be injected through .env, a credentials file,
# IAM role, or the deployment platform's secret manager.
AWS_SES_REGION="ap-northeast-1"
AWS_SES_FROM=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# Existing revalidation scheduler
REVALIDATE_SECRET=""
REVALIDATE_SCHEDULER_ENABLED="1"
POST_STATS_SCHEDULER_ENABLED="1"

# The HTTP server drops root privileges to this uid/gid after startup migration.
APP_UID="1000"
APP_GID="1000"

# Production backup volume
DATABASE_BACKUP_DIRECTORY="/app/prisma/backups"
