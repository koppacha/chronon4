# Python venv
venv/

# IDE 設定
.idea/

# Git
.git/

# ローカル node_modules は不要
node_modules/
.next/

# 実行時Secretはビルドコンテキストへ送らない
.env*
!.env.example

# Webアプリのビルドに不要なローカル作業物
labs/
docs/
tests/
_sandbox/
.playwright-cli/
*.log
*.tsbuildinfo

# ブログコンテンツはビルド時の静的生成に必要なMarkdownだけ含める
blog/**
!blog/
!blog/[0-9][0-9][0-9][0-9]/
!blog/[0-9][0-9][0-9][0-9]/[0-9][0-9]/
!blog/[0-9][0-9][0-9][0-9]/[0-9][0-9]/*.md
!blog/keyword/
!blog/keyword/*.md

# DBはビルド時に除外
prisma/dev.db
prisma/backups/**
*.db
*.db-journal
*.db-wal
*.db-shm

.DS_Store
